# Copy to .env for local runs. Never commit real secrets.

# Supabase Postgres connection (prefer pooler for hosted API):
# postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-2.pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# App bind
PORT=8010
HOST=127.0.0.1
LOG_LEVEL=INFO

# Public hostname (documented; DNS not required until stage 7)
# PUBLIC_HOSTNAME=sbdb.animarium.ai

# --- NPÚ Geoportal initial fill (docs/npu-geoportal-sync.md) ---
# Locked MapServer layer root (CP_UAP_PVO / Národní kulturní památky):
NPU_LAYER_URL=https://geoportal.npu.cz/arcgis/rest/services/Tematicke/CP_UAP_PVO/MapServer/0
# Optional display name override for map_layers.name
NPU_LAYER_NAME=
# CP_UAP_PVO attribute → tags / URLs / temporal (defaults match docs/npu-geoportal-sync.md)
# NPU_TAG_FIELDS=Subtyp,typOchranyKod,typOchranyNazev,fazeOchranyKod,fazeOchranyNazev,PrStavNazev
# NPU_URL_FIELDS=urlExt,urlInt
# NPU_TEMPORAL_FIELDS=platn_od,platn_do,aktual,datumStavuOchrany
