{
  "artifact": "notes-for-data-model",
  "domain": "GeoJSON map layers with typed properties, tags, and URL lists",
  "storage_choices": {
    "geometry": {
      "choice": "JSONB",
      "rationale": "GeoJSON Geometry as JSONB fits Supabase Free; GIN index. PostGIS optional later."
    },
    "images_and_binary_properties": {
      "choice": "Supabase Storage references",
      "rationale": "Typed image/binary properties store bucket/path/url + metadata — not BYTEA. Distinct from layer_object_urls."
    },
    "object_url_lists": {
      "choice": "layer_object_urls table (1:N)",
      "rationale": "Explicit ordered URL list per object, separate from typed image/binary Storage props."
    }
  },
  "tables": [
    {
      "name": "map_layers",
      "description": "Generic map layer containers",
      "columns": ["id", "name", "description", "created_at", "updated_at"]
    },
    {
      "name": "layer_objects",
      "description": "Layer objects / GeoJSON features",
      "foreign_keys": [{ "column": "layer_id", "references": "map_layers.id", "on_delete": "CASCADE" }],
      "columns": ["id", "layer_id", "geometry (jsonb)", "created_at", "updated_at"]
    },
    {
      "name": "layer_object_properties",
      "description": "Typed additional properties (discriminated by value_type)",
      "foreign_keys": [{ "column": "object_id", "references": "layer_objects.id", "on_delete": "CASCADE" }],
      "unique": [["object_id", "key"]],
      "discriminant": {
        "column": "value_type",
        "enum": ["text", "temporal", "image", "binary"],
        "payloads": {
          "text": ["text_value"],
          "temporal": ["temporal_value", "temporal_end?"],
          "image": ["storage_bucket", "storage_path", "storage_url?", "content_type?", "byte_size?", "checksum?", "meta"],
          "binary": ["storage_bucket", "storage_path", "storage_url?", "content_type?", "byte_size?", "checksum?", "meta"]
        }
      }
    },
    {
      "name": "tags",
      "description": "Classification labels",
      "columns": ["id", "name (unique)", "created_at", "updated_at"]
    },
    {
      "name": "layer_object_tags",
      "description": "Many-to-many: objects ↔ tags",
      "primary_key": ["object_id", "tag_id"]
    },
    {
      "name": "layer_object_urls",
      "description": "Ordered URL list per object (1:N); not typed Storage properties",
      "foreign_keys": [{ "column": "object_id", "references": "layer_objects.id", "on_delete": "CASCADE" }],
      "columns": ["id", "object_id", "url", "label", "sort_order", "created_at", "updated_at"],
      "indexes": ["(object_id, sort_order)"]
    }
  ],
  "security": {
    "rls": true,
    "note": "RLS on all tables; FastAPI uses DATABASE_URL role (bypasses RLS)."
  }
}
